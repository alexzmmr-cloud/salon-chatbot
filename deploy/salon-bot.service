[Unit]
Description=Salon Chatbot (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alexzim
WorkingDirectory=/opt/salon-bot
ExecStart=/opt/salon-bot/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
