# Yandex Cloud AI Studio — API key
# Получить: https://aistudio.yandex.ru/docs/en/ai-studio/operations/get-api-key
YC_API_KEY=

# Yandex Cloud Folder ID (виден в URL кабинета AI Studio: /platform/folders/<folder_id>)
YC_FOLDER_ID=

# Полный URI модели: gpt://<YC_FOLDER_ID>/<model_name>
# Пример: gpt://<YC_FOLDER_ID>/yandexgpt/rc
YC_MODEL_URI=

# Температура генерации модели (0.0-1.0)
YC_TEMPERATURE=0.3
